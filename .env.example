# =============================================================================
# Crypto Trading Bot — configuration
# Copy this file to `.env` and adjust the values.
# =============================================================================

# --- Safety ------------------------------------------------------------------
# Paper trading is the DEFAULT. Real orders are hard-blocked unless this is
# explicitly set to False AND valid API keys are configured.
PAPER_TRADING=True

# --- Exchange ----------------------------------------------------------------
# Supported: bitvavo, kraken
EXCHANGE=bitvavo
API_KEY=
API_SECRET=

# --- Market ------------------------------------------------------------------
# Comma-separated list of trading pairs
SYMBOLS=BTC/EUR
# Quote currency the paper account is funded in
QUOTE_CURRENCY=EUR

# --- Paper trading -----------------------------------------------------------
PAPER_STARTING_BALANCE=10000
MAKER_FEE_RATE=0.0015
TAKER_FEE_RATE=0.0025

# --- Strategy ----------------------------------------------------------------
# Supported: grid, sma_crossover
STRATEGY=grid
# Timeframe of the live bars strategies compute indicators on (1m, 5m, 15m, 1h…)
BAR_TIMEFRAME=1m

# Grid strategy
GRID_LEVELS=5
# Must stay above the fee floor: 2 x MAKER_FEE_RATE + 0.001 (else cycles lose money)
GRID_SPACING_PCT=0.005
GRID_ORDER_QUOTE_SIZE=100
# Re-center the grid when price drifts beyond GRID_REANCHOR_FACTOR x grid width
GRID_AUTO_REANCHOR=True
GRID_REANCHOR_FACTOR=1.5
# Hard cap on committed capital (inventory + resting buys) in quote currency;
# 0 = one full grid (levels x order size)
GRID_MAX_INVENTORY_QUOTE=0

# SMA crossover strategy
SMA_FAST_PERIOD=10
SMA_SLOW_PERIOD=30
SMA_ORDER_QUOTE_SIZE=250

# --- Notifications (Telegram / Discord webhooks) ------------------------------
# Configure at least one channel to receive fill, SL/TP, drawdown, and
# disconnect alerts plus a periodic PnL digest. Leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
DIGEST_INTERVAL_HOURS=24

# --- Risk management ---------------------------------------------------------
# Max fraction of portfolio equity a single order may allocate (0.10 = 10%)
MAX_ALLOCATION_PCT=0.10
# Max portfolio drawdown from peak equity before new entries are blocked
MAX_DRAWDOWN_PCT=0.15
# Mandatory protective levels applied to every entry
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04
# Max number of simultaneously open orders per symbol
MAX_OPEN_ORDERS=10
# Minimum order notional in quote currency
MIN_ORDER_NOTIONAL=5

# --- Persistence -------------------------------------------------------------
# SQLite database shared by the bot and the Streamlit dashboard
DB_PATH=data/bot_state.db
# Seconds between bot_config polls for runtime setting changes
CONFIG_POLL_INTERVAL=5
# Seconds between equity curve snapshots
EQUITY_SNAPSHOT_INTERVAL=30
# Seconds between liveness heartbeats (dashboard status indicator)
HEARTBEAT_INTERVAL=5

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
# Rotating log file, tailed by the dashboard's Live Logs tab
LOG_FILE=logs/bot.log
# Seconds between PnL summary log lines
PNL_SUMMARY_INTERVAL=30
